{
  "name": "learn-chinese",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "quality": "npm test && npm run lint && npm run build",
    "harness:hanzi": "vitest run src/lib/__tests__/hanziHarness.test.ts src/lib/__tests__/hanziTrustPolicy.test.ts src/lib/__tests__/hanziPedagogyValidator.test.ts",
    "harness:hanzi:report": "tsx scripts/hanzi-harness-report.ts",
    "hanzi:cache": "tsx scripts/query-hanzi-cache.ts",
    "hanzi:batch": "tsx scripts/test-hanzi-lab-batch.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "content:backfill": "tsx scripts/backfill-content-metadata.ts",
    "purge:demo-sets": "tsx scripts/purge-legacy-demo-sets.ts",
    "verify:sample": "tsx scripts/verify-user-set-sample.ts",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "mongodb": "^6.21.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
