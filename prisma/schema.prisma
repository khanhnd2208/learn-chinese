// Learn Chinese — standalone vocabulary app (PostgreSQL)
// userId references MongoDB User._id via NextAuth

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum CnContentStatus {
  draft
  published
}

enum CnWordSetSource {
  manual
  hsk
  textbook
}

enum CnWordProgressState {
  new
  learning
  weak
  familiar
  strong
  mastered
}

enum CnQuestionType {
  // Active MVP types (app generates these only)
  hanzi_to_meaning
  meaning_to_hanzi
  meaning_to_hanzi_typed
  sound_to_hanzi
  sound_to_hanzi_typed
  fill_sentence
  fill_sentence_typed
  // Legacy — kept for historical CnAnswerLog rows
  pinyin_to_hanzi
  hanzi_to_pinyin
  hanzi_to_pinyin_typed
  audio_to_hanzi
  audio_to_hanzi_typed
  audio_to_meaning
  audio_to_pinyin
  audio_to_pinyin_typed
  hanzi_from_meaning
  sentence_order
  radical_pick
  char_components
  similar_char
  translate_sentence
}

enum CnAnswerSource {
  practice
  review
  mark_known
  integrated
  inferno
  hht
}

enum CnErrorType {
  sai_nghia
  sai_pinyin
  sai_thanh_dieu
  nghe_khong_ra
  nham_chu
  quen_hanzi
  sai_mau_cau
  sai_vi_tri
  qua_han
}

model CnSimilarGroup {
  id                    String   @id @default(cuid())
  key                   String   @unique
  note                  String   @default("")
  confusionType         String?
  explanationVi         String   @default("")
  difficultyLevel       String?
  minimalDifferenceNote String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  hanzi                 CnHanzi[]
}

model CnHanzi {
  id             String          @id @default(cuid())
  char           String          @unique
  pinyin         String          @default("")
  hanViet        String          @default("")
  meaningVi      String          @default("")
  components     String[]        @default([])
  radical        String          @default("")
  mnemonicVi              String          @default("")
  similarGroupId          String?
  componentAnalysisStatus String          @default("basic")
  structureType           String?
  strokeCount             Int?
  status                  CnContentStatus @default(draft)
  systemCheckedFields  String[] @default([])
  expertVerifiedFields String[] @default([])
  verifiedAt           DateTime?
  verifiedById         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  similarGroup   CnSimilarGroup? @relation(fields: [similarGroupId], references: [id], onDelete: SetNull)
  wordChars      CnWordChar[]
  @@index([status])
  @@index([similarGroupId])
}

model CnWord {
  id           String          @id @default(cuid())
  simplified   String          @unique
  pinyin       String          @default("")
  hanViet      String          @default("")
  meaningVi    String          @default("")
  partOfSpeech String          @default("")
  mnemonicVi           String          @default("")
  usageNoteVi          String          @default("")
  ghiChu               String          @default("")
  hskLevel             Int?
  pinyinPlain          String          @default("")
  pinyinNumbered       String          @default("")
  pinyinSyllables      String[]        @default([])
  tones                Int[]           @default([])
  frequencyRank        Int?
  difficultyLevel      String?
  isFunctionWord       Boolean         @default(false)
  learningPriority     Int?
  status               CnContentStatus @default(draft)
  systemCheckedFields  String[] @default([])
  expertVerifiedFields String[] @default([])
  verifiedAt           DateTime?
  verifiedById         String?
  createdByUserId      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  chars        CnWordChar[]
  senses       CnWordSense[]
  examples     CnExample[]
  patterns     CnSentencePattern[]
  setItems     CnWordSetItem[]
  progress        CnWordProgress[]
  userOverrides   CnUserWordOverride[]
  answerLogs      CnAnswerLog[]
  infernoProgress CnInfernoProgress[]
  hhtProgress     CnHhtProgress[]
  @@index([status])
  @@index([hskLevel])
}

model CnWordChar {
  id       String @id @default(cuid())
  wordId   String
  hanziId  String
  position Int
  word     CnWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  hanzi    CnHanzi @relation(fields: [hanziId], references: [id], onDelete: Cascade)
  @@unique([wordId, position])
  @@index([hanziId])
}

model CnWordSense {
  id           String   @id @default(cuid())
  wordId       String
  meaningVi    String
  partOfSpeech String   @default("")
  usageNoteVi  String   @default("")
  isPrimary    Boolean  @default(false)
  level        String?
  word         CnWord   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples     CnExample[]
  @@index([wordId])
}

model CnExample {
  id                  String       @id @default(cuid())
  wordId              String
  senseId             String?
  hanzi               String
  pinyin              String       @default("")
  meaningVi           String       @default("")
  meaningViTemplate   String       @default("")
  targetWordStart     Int?
  targetWordEnd       Int?
  difficultyLevel     String?
  grammarTags         String[]     @default([])
  naturalnessStatus   String       @default("draft")
  unknownWordEstimate Int?
  source              String       @default("admin")
  ownerUserId         String?
  acceptedAnswers     String[]     @default([])
  qualityReviewedAt   DateTime?
  sourceHanzi         String?
  word                CnWord       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  disputes            CnExampleDispute[]
  sense               CnWordSense? @relation(fields: [senseId], references: [id], onDelete: SetNull)
  @@index([wordId])
  @@index([senseId])
  @@index([wordId, naturalnessStatus])
  @@index([wordId, ownerUserId])
}

model CnExampleDispute {
  id             String    @id @default(cuid())
  exampleId      String
  wordId         String
  userId         String
  answer         String
  clientAnswerId String?
  status         String    @default("pending")
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  example        CnExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)

  @@unique([userId, clientAnswerId])
  @@index([status, createdAt])
  @@index([exampleId, status])
}

model CnUserWordOverride {
  id           String   @id @default(cuid())
  userId       String
  wordId       String
  pinyin       String?
  hanViet      String?
  meaningVi    String?
  partOfSpeech String?
  ghiChu       String?
  mnemonicVi   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  word         CnWord   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
}

model CnSentencePattern {
  id       String @id @default(cuid())
  wordId   String
  template String
  samples  Json   @default("[]")
  word     CnWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@index([wordId])
}

model CnWordSet {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String          @default("")
  source      CnWordSetSource @default(manual)
  /// Deprecated. Review membership lives on CnSetEnrollment.srsActive.
  srsActive   Boolean         @default(false)
  /// Published to Khám phá. Learners follow the original set.
  shared      Boolean         @default(false)
  publishedAt DateTime?
  /// HSK level used to filter Khám phá. Null means unset.
  level       Int?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       CnWordSetItem[]
  enrollments CnSetEnrollment[]
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, srsActive])
  @@index([shared])
  @@index([shared, level, sortOrder])
}

model CnSetEnrollment {
  id        String    @id @default(cuid())
  userId    String
  setId     String
  srsActive Boolean   @default(true)
  createdAt DateTime  @default(now())
  set       CnWordSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId, srsActive])
}

model CnWordSetItem {
  id      String  @id @default(cuid())
  setId   String
  wordId  String?
  rawTerm String
  set     CnWordSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  word    CnWord?   @relation(fields: [wordId], references: [id], onDelete: SetNull)
  @@unique([setId, rawTerm])
  @@index([setId])
  @@index([wordId])
}

model CnWordProgress {
  id               String              @id @default(cuid())
  userId           String
  wordId           String
  state            CnWordProgressState @default(new)
  dueAt            DateTime            @default(now())
  intervalIdx      Int                 @default(0)
  lastReviewedAt   DateTime?
  meaningCorrect   Int                 @default(0)
  meaningTotal     Int                 @default(0)
  soundCorrect     Int                 @default(0)
  soundTotal       Int                 @default(0)
  sentenceCorrect  Int                 @default(0)
  sentenceTotal    Int                 @default(0)
  meaningDueAt     DateTime?
  meaningIntervalIdx Int               @default(0)
  soundDueAt       DateTime?
  soundIntervalIdx Int                 @default(0)
  sentenceDueAt    DateTime?
  sentenceIntervalIdx Int              @default(0)
  sentenceUnlockedAt DateTime?
  lastExampleId      String?
  meaningHeavyLapses   Int @default(0)
  soundHeavyLapses     Int @default(0)
  sentenceHeavyLapses  Int @default(0)
  isStickingPoint      Boolean @default(false)
  meaningMarkedKnownAt   DateTime?
  soundMarkedKnownAt     DateTime?
  sentenceMarkedKnownAt  DateTime?
  sentenceIntroDayKey    String?
  sentenceIntroDayCount  Int @default(0)
  introducedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  word             CnWord              @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@unique([userId, wordId])
  @@index([userId, dueAt])
  @@index([userId, state])
  @@index([userId, meaningDueAt])
  @@index([userId, soundDueAt])
  @@index([userId, sentenceDueAt])
  @@index([userId, introducedAt])
}

model CnAnswerLog {
  id           String         @id @default(cuid())
  userId       String
  wordId       String
  questionType CnQuestionType
  errorType    CnErrorType?
  correct      Boolean
  source       CnAnswerSource @default(practice)
  hintUsed     Boolean        @default(false)
  responseMs   Int?
  clientAnswerId String?
  exampleId        String?
  channelIdxBefore Int?
  attempts         Int?
  disputed         Boolean        @default(false)
  answer           String?
  createdAt    DateTime       @default(now())
  word         CnWord         @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@unique([userId, clientAnswerId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, wordId])
  @@index([userId, errorType])
  @@index([userId, source, createdAt])
  @@index([exampleId, createdAt])
}

model CnInfernoProgress {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  masteryScore   Int       @default(0)
  correctMcq     Int       @default(0)
  correctFill    Int       @default(0)
  wrongCount     Int       @default(0)
  lastAnsweredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  word           CnWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@unique([userId, wordId])
  @@index([userId])
}

model CnHhtProgress {
  id              String    @id @default(cuid())
  userId          String
  wordId          String
  selectionWeight Float     @default(1.0)
  correctCount    Int       @default(0)
  wrongCount      Int       @default(0)
  lastAnsweredAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  word            CnWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  @@unique([userId, wordId])
  @@index([userId])
}

model CnUserMessage {
  id             String    @id @default(cuid())
  userId         String
  recipientEmail String    @default("")
  content        String
  createdById    String
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, dismissedAt])
  @@index([createdAt(sort: Desc)])
}

// English learning tables. Additive only — do not alter Cn* models in this migration.

enum EnContentStatus {
  draft
  published
  suspended
}

enum EnWordSkill {
  meaning
  sound
  usage
}

enum EnAnswerSkill {
  meaning
  sound
  usage
  pattern
}

enum EnStage {
  new
  recall
  maintain
}

enum EnQuestionKind {
  meaning_choice
  meaning_confusable
  listen_choice
  listen_type
  spell_type
  usage_fill
  pattern_order
  pattern_fill
}

enum EnGradeResult {
  target_correct
  alternate_plausible
  wrong
  pending_review
  skipped
}

enum EnExampleRole {
  study
  grade
}

model EnWord {
  id           String          @id @default(cuid())
  lemma        String
  ipa          String          @default("")
  stress       String          @default("")
  partOfSpeech String          @default("")
  forms        String[]        @default([])
  audioPath    String          @default("")
  status       EnContentStatus @default(draft)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  senses       EnSense[]

  @@index([status])
  @@index([lemma])
}

model EnSense {
  id                  String          @id @default(cuid())
  wordId              String
  meaningVi           String
  partOfSpeech        String          @default("")
  collocations        String[]        @default([])
  pitfallVi           String          @default("")
  distractorMeanings  String[]        @default([])
  distractorLemmas    String[]        @default([])
  isPrimary           Boolean         @default(true)
  status              EnContentStatus @default(draft)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  word                EnWord          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples            EnExample[]
  questions           EnQuestion[]
  skills              EnSenseSkill[]
  patternLinks        EnPatternSense[]
  setItems            EnSetItem[]

  @@index([wordId])
  @@index([status])
}

model EnExample {
  id            String          @id @default(cuid())
  senseId       String
  english       String
  meaningVi     String          @default("")
  target        String
  audioPath     String          @default("")
  role          EnExampleRole   @default(study)
  alternatives  String[]        @default([])
  ambiguityNote String          @default("")
  status        EnContentStatus @default(draft)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sense         EnSense         @relation(fields: [senseId], references: [id], onDelete: Cascade)
  questions     EnQuestion[]

  @@index([senseId, status, role])
}

model EnPattern {
  id         String          @id @default(cuid())
  purposeVi  String
  frame      String
  fixedParts String[]        @default([])
  slots      Json            @default("[]")
  pitfallVi  String          @default("")
  status     EnContentStatus @default(draft)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  examples   EnPatternExample[]
  questions  EnQuestion[]
  senses     EnPatternSense[]
  progress   EnPatternProgress[]
  setItems   EnSetItem[]

  @@index([status])
}

model EnPatternExample {
  id         String          @id @default(cuid())
  patternId  String
  english    String
  meaningVi  String          @default("")
  slotValues Json            @default("[]")
  audioPath  String          @default("")
  status     EnContentStatus @default(draft)
  createdAt  DateTime        @default(now())
  pattern    EnPattern       @relation(fields: [patternId], references: [id], onDelete: Cascade)
  questions  EnQuestion[]

  @@index([patternId, status])
}

model EnPatternSense {
  id        String    @id @default(cuid())
  patternId String
  senseId   String
  pattern   EnPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  sense     EnSense   @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([patternId, senseId])
  @@index([senseId])
}

model EnQuestion {
  id               String          @id @default(cuid())
  key              String          @unique
  kind             EnQuestionKind
  skill            EnAnswerSkill
  stage            EnStage
  senseId          String?
  patternId        String?
  exampleId        String?
  patternExampleId String?
  prompt           Json
  answer           String
  acceptedAnswers  String[]        @default([])
  audioPath        String          @default("")
  status           EnContentStatus @default(draft)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sense            EnSense?          @relation(fields: [senseId], references: [id], onDelete: Cascade)
  pattern          EnPattern?        @relation(fields: [patternId], references: [id], onDelete: Cascade)
  example          EnExample?        @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  patternExample   EnPatternExample? @relation(fields: [patternExampleId], references: [id], onDelete: Cascade)
  logs             EnAnswerLog[]
  disputes         EnDispute[]
  audioOpens       EnAudioOpen[]

  @@index([status, skill, stage])
  @@index([senseId])
  @@index([patternId])
  @@index([exampleId])
}

model EnSet {
  id          String          @id @default(cuid())
  title       String
  description String          @default("")
  status      EnContentStatus @default(draft)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       EnSetItem[]
  enrollments EnEnrollment[]

  @@index([status, sortOrder])
}

model EnSetItem {
  id        String     @id @default(cuid())
  setId     String
  senseId   String?
  patternId String?
  position  Int        @default(0)
  set       EnSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  sense     EnSense?   @relation(fields: [senseId], references: [id], onDelete: Cascade)
  pattern   EnPattern? @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([setId, position])
  @@index([senseId])
  @@index([patternId])
}

model EnEnrollment {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  createdAt DateTime @default(now())
  set       EnSet    @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId])
}

model EnSenseSkill {
  id              String      @id @default(cuid())
  userId          String
  senseId         String
  skill           EnWordSkill
  intervalIdx     Int         @default(0)
  dueAt           DateTime    @default(now())
  state           String      @default("learning")
  lastReviewedAt  DateTime?
  introducedAt    DateTime?
  correctCount    Int         @default(0)
  totalCount      Int         @default(0)
  longGapRecallAt DateTime?
  usageExampleIds String[]    @default([])
  lastExampleId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sense           EnSense     @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([userId, senseId, skill])
  @@index([userId, dueAt])
  @@index([userId, skill, dueAt])
  @@index([userId, introducedAt])
}

model EnPatternProgress {
  id             String    @id @default(cuid())
  userId         String
  patternId      String
  intervalIdx    Int       @default(0)
  dueAt          DateTime  @default(now())
  state          String    @default("learning")
  lastReviewedAt DateTime?
  introducedAt   DateTime?
  credits        Json      @default("[]")
  lastExampleId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  pattern        EnPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
  @@index([userId, dueAt])
}

model EnAnswerLog {
  id             String        @id @default(cuid())
  userId         String
  questionId     String
  senseId        String?
  patternId      String?
  exampleId      String?
  skill          EnAnswerSkill
  clientAnswerId String
  answer         String        @default("")
  result         EnGradeResult
  audioOpened    Boolean       @default(false)
  intervalIdxBefore Int?
  createdAt      DateTime      @default(now())
  question       EnQuestion    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([userId, clientAnswerId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, senseId, skill])
  @@index([userId, patternId])
  @@index([questionId, createdAt])
}

model EnAudioOpen {
  id             String     @id @default(cuid())
  userId         String
  questionId     String
  clientAnswerId String
  createdAt      DateTime   @default(now())
  question       EnQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, clientAnswerId])
  @@index([userId, questionId])
}

model EnDispute {
  id             String     @id @default(cuid())
  userId         String
  questionId     String
  answer         String
  clientAnswerId String
  status         String     @default("pending")
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime   @default(now())
  question       EnQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([userId, clientAnswerId])
  @@index([status, createdAt])
  @@index([questionId, status])
}
