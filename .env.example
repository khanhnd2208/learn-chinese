# Learn Chinese — standalone app
# Copy to .env.local and fill in values

# App URL (port 3001 by default)
NEXTAUTH_URL=http://localhost:3001
AUTH_SECRET=your-secret-here
AUTH_TRUST_HOST=true

# Google OAuth (same or separate OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated admin emails (first login gets admin role)
ADMIN_EMAILS=your-admin@gmail.com

# MongoDB (NextAuth users — can share cluster, separate DB name recommended)
MONGODB_URI=mongodb://127.0.0.1:27017/learn_chinese_auth

# PostgreSQL (Chinese vocabulary content)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/learn_chinese
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000

HANZI_AI_TEMPERATURE=0.1
HANZI_AI_PROMPT_VERSION=hanzi-v3-trust
HANZI_AI_SCHEMA_VERSION=2
HANZI_AI_INPUT_COST_PER_MILLION_USD=0.14
HANZI_AI_OUTPUT_COST_PER_MILLION_USD=0.28
